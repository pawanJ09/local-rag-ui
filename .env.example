# Where the backend is, and the key it expects (the same value as the
# backend's own API_KEY). These two settings are used for BOTH `make dev` and
# the Docker image (`make docker-run` reads this file).
API_BASE_URL=http://localhost:8000
API_KEY=changeme-local-dev-key

# The backend's ALLOWED_ORIGINS must include the address you open the UI at:
#   make dev     -> http://localhost:5173 (already the backend default)
#   Docker image -> http://localhost:3000
# Running the image yourself:
#   docker run -p 3000:80 -e API_BASE_URL=... -e API_KEY=... local-rag-ui
